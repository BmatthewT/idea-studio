<Window x:Class="IdeaStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Icon="Assets/app.ico" Title="Idea Studio" Width="1180" Height="850" MinWidth="820" MinHeight="620" Background="#000000" FontFamily="Segoe UI" FontSize="14" Foreground="#F2F3F5" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#15171B"/>
  <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#F2F3F5"/>
  <Style TargetType="Label"><Setter Property="Foreground" Value="#E4E6E9"/></Style>
  <Style TargetType="RadioButton"><Setter Property="Foreground" Value="#F2F3F5"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F2F3F5"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="18,11"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Background" Value="#181A1E"/><Setter Property="Foreground" Value="#E4E6E9"/><Setter Property="BorderBrush" Value="#373B43"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#B6F36A"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderThickness" Value="2"/><Setter TargetName="Surface" Property="BorderBrush" Value="#B6F36A"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="16,12"/><Setter Property="Background" Value="#181A1E"/><Setter Property="BorderBrush" Value="#414650"/><Setter Property="Foreground" Value="#F2F3F5"/><Setter Property="CaretBrush" Value="#B6F36A"/><Setter Property="SelectionBrush" Value="#486B27"/><Setter Property="VerticalContentAlignment" Value="Top"/><Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#B6F36A"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="InputBorder" Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#A3A9B3"/><Setter Property="Padding" Value="23,12"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#B6F36A"/><Setter TargetName="Tab" Property="BorderBrush" Value="#B6F36A"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tab" Property="Background" Value="#272C33"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#F2F3F5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="#101114"/><Setter Property="BorderBrush" Value="#30343B"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><DockPanel><TabPanel DockPanel.Dock="Top" IsItemsHost="True" Margin="0,0,0,12"/><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8"><ContentPresenter ContentSource="SelectedContent"/></Border></DockPanel></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="9"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#414650" CornerRadius="4" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb></Track></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <DockPanel Margin="34,26"><TextBlock DockPanel.Dock="Bottom" Text="created by matthew" Foreground="#A3A9B3" FontSize="12" HorizontalAlignment="Right" Margin="0,8,0,0"/>
  <Grid DockPanel.Dock="Top" Margin="0,0,0,28"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Idea Studio" FontWeight="SemiBold" FontSize="25"/><TextBlock Text="From a rough thought to a clear brief." Foreground="#A3A9B3" Margin="0,5,0,0" FontSize="13"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Home" Click="HomeClick"/><Button x:Name="NewMenu" Content="New" Click="NewClick"/><Button x:Name="OpenMenu" Content="Open project" Click="OpenClick"/><Button x:Name="SaveMenu" Content="Save project" Click="SaveClick"/><Button x:Name="SettingsMenu" Content="Settings" Click="SettingsClick"/></StackPanel></Grid>
  <TextBlock x:Name="Status" DockPanel.Dock="Bottom" Text="Local workspace • No account needed" Foreground="#A3A9B3" FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <UniformGrid x:Name="Steps" Columns="4" Margin="0,0,0,24"/>
   <Border Grid.Row="1" CornerRadius="12" Background="#101114" BorderBrush="#30343B" BorderThickness="1" Padding="28"><ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Page"/></ScrollViewer></Border>
   <Grid Grid.Row="2" Margin="0,22,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="Back" Content="Back" HorizontalAlignment="Left" Click="BackClick"/><Button x:Name="Next" Grid.Column="1" Content="Continue" Background="#B6F36A" Foreground="#10140A" BorderBrush="#B6F36A" FontWeight="SemiBold" Click="NextClick"/></Grid>
  </Grid>
 </DockPanel>
</Window>




